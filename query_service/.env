APP_NAME=xunke-query-service
APP_ENV=dev
APP_PORT=8000

# 业务库（只查）
# MYSQL_HOST=10.80.6.54
# MYSQL_HOST=10.185.8.239
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD=kedacom@123
MYSQL_PASSWORD=123456
# MYSQL_DATABASE=jy_application_digital_patrol
MYSQL_DATABASE=jy_digital_patrol
MYSQL_CHARSET=utf8mb4

# 课表库（今日总排课/总节次口径，建议改为只读账号）
# SCHEDULE_MYSQL_HOST=10.185.8.239
SCHEDULE_MYSQL_HOST=127.0.0.1
SCHEDULE_MYSQL_PORT=3306
SCHEDULE_MYSQL_USER=root
SCHEDULE_MYSQL_PASSWORD=123456
SCHEDULE_MYSQL_DATABASE=course
SCHEDULE_MYSQL_CHARSET=utf8mb4
SCHEDULE_TENANT_ORG_CODE=RBAC

# 控制库（模板/审计）
# CONTROL_MYSQL_HOST=10.185.8.239
CONTROL_MYSQL_HOST=127.0.0.1
CONTROL_MYSQL_PORT=3306
CONTROL_MYSQL_USER=root
CONTROL_MYSQL_PASSWORD=123456
CONTROL_MYSQL_DATABASE=agent_data_patrol

# 业务库强只读
DB_READONLY=true


LLM_BASE_URL=http://10.80.5.130:8855/v1
LLM_MODEL=qwen3-32b
LLM_API_KEY=EMPTY
LLM_TIMEOUT_SEC=20
ASSISTANT_TRACE_ENABLED=true 
ASSISTANT_DEFAULT_TENANT_ID=RBAC

# AI巡课阈值（可按业务调整）
PATROL_FOCUS_ATTENDANCE_LT=30
PATROL_FOCUS_FRONT_FULL_LT=30
PATROL_FOCUS_RISE_LT=30
PATROL_VITALITY_ATTENDANCE_GTE=70
PATROL_VITALITY_FRONT_FULL_GTE=70
PATROL_VITALITY_RISE_GTE=70
