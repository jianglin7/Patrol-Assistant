APP_NAME=patrol-assistant
APP_ENV=dev
APP_PORT=8000
MYSQL_HOST=10.80.6.54
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=kedacom@123
MYSQL_DATABASE=jy_application_digital_patrol
MYSQL_CHARSET=utf8mb4
# 控制库（模板/审计）可单独配置；不填则复用上面的业务库连接
# CONTROL_MYSQL_HOST=10.80.6.60
# CONTROL_MYSQL_PORT=3306
# CONTROL_MYSQL_USER=root
# CONTROL_MYSQL_PASSWORD=your_password
# CONTROL_MYSQL_DATABASE=patrol_assistant_control
# CONTROL_MYSQL_CHARSET=utf8mb4
# 课表库（如 jy_course_he）可单独配置；不填则复用业务库连接
# 建议使用只读账号（仅 SELECT），用于“今日总排课/总节次”口径
# SCHEDULE_MYSQL_HOST=10.80.6.61
# SCHEDULE_MYSQL_PORT=3306
# SCHEDULE_MYSQL_USER=root
# SCHEDULE_MYSQL_PASSWORD=your_password
# SCHEDULE_MYSQL_DATABASE=jy_course_he
# SCHEDULE_MYSQL_CHARSET=utf8mb4
# 若课表库 tenant_org_code 与AI巡课库 tenant_id 不一致，可配置固定映射值
# SCHEDULE_TENANT_ORG_CODE=RBAC
# 只读模式：true 时仅允许查询，不写 ai_query_audit_log
# DB_READONLY=true
# AI巡课阈值（可按业务调整）
# PATROL_FOCUS_ATTENDANCE_LT=90
# PATROL_FOCUS_FRONT_FULL_LT=65
# PATROL_FOCUS_RISE_LT=65
# PATROL_VITALITY_ATTENDANCE_GTE=95
# PATROL_VITALITY_FRONT_FULL_GTE=80
# PATROL_VITALITY_RISE_GTE=75
LLM_BASE_URL=http://10.80.5.197:8855/v1
LLM_MODEL=qwen3-8b
LLM_API_KEY=EMPTY
LLM_TIMEOUT_SEC=20
# Qwen3+vLLM：false=请求里关闭思考（直接回答）；true=开启思考模式
# LLM_ENABLE_THINKING=false
# 助手路由增强：启用后会先用 LLM 做意图分类（JSON），高置信度时自动走对应业务简报
# ASSISTANT_INTENT_LLM_ENABLED=true
# ASSISTANT_INTENT_LLM_MIN_CONFIDENCE=0.55
# TopN 参数（展示维度）
# ASSISTANT_DEFAULT_TOP_N=5
# ASSISTANT_MAX_TOP_N=20
# 追问上下文：按“租户+会话”短时记忆上一次查询条件（如 TopN/学院/节次/学段）
# ASSISTANT_CONTEXT_ENABLED=true
# ASSISTANT_CONTEXT_TTL_SEC=1800
# ASSISTANT_CONTEXT_MAX_ENTRIES=500
# 自动化取数规划器（随机问题自动映射为 DSL + QueryPlan）
# ASSISTANT_AUTO_PLAN_ENABLED=true
# ASSISTANT_AUTO_PLAN_MIN_CONFIDENCE=0.45
# ASSISTANT_AUTO_PLAN_RESOURCE_DIR=resources/assistant_semantic
# 主问答链路是否同时执行 QueryPlan 白名单模板；默认关闭，避免未初始化模板库时增加延迟
# ASSISTANT_AUTO_PLAN_TEMPLATE_EXECUTE_ENABLED=false
# ASSISTANT_AUTO_PLAN_TEMPLATE_CONTINUE_ON_ERROR=true
# 控制库未注册语义模板时，使用代码内置只读白名单模板兜底
# ASSISTANT_BUILTIN_TEMPLATE_FALLBACK_ENABLED=true
# 语义取数结果报告生成：把 QueryPlan 执行结果交给 LLM 组织成差异化回答
# ASSISTANT_SEMANTIC_REPORT_ENABLED=true
# ASSISTANT_SEMANTIC_REPORT_MAX_STEPS=6
# ASSISTANT_SEMANTIC_REPORT_MAX_ROWS_PER_STEP=5
# ASSISTANT_SEMANTIC_REPORT_MAX_TOKENS=900
# 信息不足或实体角色不明确时，优先追问确认，避免按错误口径硬答
# ASSISTANT_CLARIFICATION_ENABLED=true
# ASSISTANT_CLARIFICATION_LLM_ENABLED=true
# ASSISTANT_CLARIFICATION_LLM_MIN_CONFIDENCE=0.62
# ASSISTANT_CLARIFICATION_LLM_MAX_TOKENS=420
# ASSISTANT_CLARIFICATION_LLM_TIMEOUT_SEC=5
# 业务简报结果短缓存（降低重复查询开销）
# ASSISTANT_RESULT_CACHE_ENABLED=true
# ASSISTANT_RESULT_CACHE_TTL_SEC=20
# ASSISTANT_RESULT_CACHE_MAX_ENTRIES=1000
# 流式输出体验参数（单位秒）
# ASSISTANT_STREAM_THINKING_DELAY_SEC=0.45
# ASSISTANT_STREAM_CHAR_DELAY_SEC=0.002
# ASSISTANT_STREAM_PRESET_THINKING_DELAY_SEC=0.9
# ASSISTANT_STREAM_PRESET_CHAR_DELAY_SEC=0.002
# ASSISTANT_STREAM_CHUNK_SIZE=16
# ASSISTANT_STREAM_PRESET_CHUNK_SIZE=18
# 助手各阶段耗时追踪（内存），供 GET /api/debug/assistant-traces 查询；勿对小助手页面暴露
# ASSISTANT_TRACE_ENABLED=true
# ASSISTANT_TRACE_MAX_ENTRIES=200
# 未传 tenant_id 时AI巡课/助手使用的租户（与库中 tenant_id 一致；不设则使用服务内置默认）
ASSISTANT_DEFAULT_TENANT_ID=RBAC
# 本地头像文件（容器内路径）；不填则使用内置 SVG 占位头像
# ASSISTANT_AVATAR_PATH=/app/assets/robot.png
# USER_AVATAR_PATH=/app/assets/user.png
# 第三方页面用 fetch 调本服务 API 时填写浏览器 Origin，逗号分隔；留空不启用 CORS。仅内网 iframe 嵌入可不填
# CORS_ALLOW_ORIGINS=https://portal.example.edu,http://localhost:5173
# CORS_ALLOW_ORIGINS=*
